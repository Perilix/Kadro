# Copier en .env (jamais commité) et renseigner.

# MongoDB Atlas — chaîne de connexion du cluster (Database > Connect > Drivers).
MONGODB_URI=mongodb+srv://kadro-api:<mot-de-passe>@<cluster>.mongodb.net/kadro?retryWrites=true&w=majority

# Secrets JWT — 32+ caractères aléatoires chacun (openssl rand -hex 32). Jamais les mêmes.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

PORT=3000
# Origines autorisées, séparées par des virgules. Vide en dev = tout autoriser.
CORS_ORIGINS=
# Base des liens d'invitation partagés aux athlètes.
JOIN_URL_BASE=https://kadro-app.com/rejoindre
