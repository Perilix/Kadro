# Copier en .env (jamais commité) et renseigner.

# MongoDB Atlas — chaîne de connexion du cluster (Database > Connect > Drivers).
MONGODB_URI=mongodb+srv://kadro-api:<mot-de-passe>@<cluster>.mongodb.net/kadro?retryWrites=true&w=majority

# Secrets JWT — 32+ caractères aléatoires chacun (openssl rand -hex 32). Jamais les mêmes.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

PORT=3000
# Origines autorisées, séparées par des virgules. Vide en dev = tout autoriser.
CORS_ORIGINS=
# Base des liens d'invitation partagés aux athlètes.
JOIN_URL_BASE=https://kadro-app.com/rejoindre

# URL publique de l'API (callbacks OAuth des connecteurs). En prod : https://kadro-api.onrender.com
API_PUBLIC_URL=http://localhost:3000
# Deep link ouvert après la connexion d'une montre depuis le mobile.
MOBILE_REDIRECT_URL=kadro://connections
# Clé de chiffrement des tokens fournisseurs (openssl rand -hex 32). Obligatoire pour les connecteurs.
TOKENS_ENC_KEY=
# Strava — créer l'app sur strava.com/settings/api (callback : <API_PUBLIC_URL>/v1/connections/strava/callback).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Jeton de vérification du webhook Strava (valeur libre, la même que dans la création de la subscription).
STRAVA_VERIFY_TOKEN=
# Polar AccessLink — client OAuth créé sur admin.polaraccesslink.com (redirect : <API_PUBLIC_URL>/v1/connections/polar/callback).
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=

# Resend — e-mails transactionnels (invitations). Sans clé, les envois sont ignorés (loggés).
RESEND_API_KEY=
# Expéditeur — onboarding@resend.dev tant que le domaine kadro.app n'est pas vérifié chez Resend.
MAIL_FROM=Kadro <onboarding@resend.dev>

# Stripe (mode test possible sans société) — dashboard.stripe.com/apikeys + 6 prix (Products).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO_MONTH=
STRIPE_PRICE_SOLO_YEAR=
STRIPE_PRICE_COACH_MONTH=
STRIPE_PRICE_COACH_YEAR=
STRIPE_PRICE_STRUCTURE_MONTH=
STRIPE_PRICE_STRUCTURE_YEAR=
